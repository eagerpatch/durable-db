{
  "name": "durable-db-migration-smoke-test",
  "main": "./worker.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_DO",
        "class_name": "TestMigrationDO"
      },
      {
        "name": "TEST_KYSELY_DO",
        "class_name": "TestKyselyDO"
      },
      {
        "name": "TEST_RACE_DO",
        "class_name": "TestRaceDO"
      },
      {
        "name": "TEST_DEV_HANDOFF_DO",
        "class_name": "TestDevHandoffDO"
      },
      {
        "name": "TEST_ARGS_DO",
        "class_name": "TestArgsDO"
      },
      {
        "name": "TEST_REMOVED_DO",
        "class_name": "TestRemovedDatabaseDO"
      },
      {
        "name": "TEST_OUTBOX_DO",
        "class_name": "TestOutboxDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TestMigrationDO",
        "TestKyselyDO",
        "TestRaceDO",
        "TestDevHandoffDO",
        "TestArgsDO",
        "TestRemovedDatabaseDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "TestOutboxDO"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OUTBOX_LOG",
      "id": "outbox-log"
    }
  ]
}
